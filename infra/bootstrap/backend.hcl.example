# Copy to backend.hcl (git-ignored) after the first apply and migration (docs/runbooks/terraform-bootstrap.md).
# Both values come from the root's outputs. The KMS ARN contains the account ID, so this file is never committed.
bucket     = "graveyard-tfstate-xxxxxxxx"
kms_key_id = "arn:aws:kms:eu-west-2:123456789012:key/00000000-0000-0000-0000-000000000000"
