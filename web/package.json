{
  "name": "graveyard-web",
  "version": "0.1.0",
  "private": true,
  "description": "Graveyard web app (spec ui-core): landing, exhumation, graveyard scene, Lights On table, death certificate.",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=22.22.2 <23"
  },
  "scripts": {
    "predev": "npm run gen:evidence --silent",
    "dev": "next dev -p 5173",
    "prebuild": "npm run gen:evidence --silent",
    "build": "next build",
    "build:e2e": "NEXT_PUBLIC_API_MOCKING=enabled NEXT_PUBLIC_API_URL=https://api.e2e.invalid next build && node scripts/e2e-build.mjs",
    "start": "serve out -l 5173",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "gen:api": "openapi-typescript ../backend/api/openapi.yaml -o lib/api/schema.d.ts",
    "check:build": "node scripts/check-build.mjs",
    "lhci": "lhci autorun",
    "gen:evidence": "node scripts/gen-evidence.mjs",
    "pretest": "npm run gen:evidence --silent",
    "prelint": "npm run gen:evidence --silent",
    "pretypecheck": "npm run gen:evidence --silent"
  },
  "dependencies": {
    "@fontsource/cormorant-garamond": "5.3.0",
    "@fontsource/inter": "5.3.0",
    "@fontsource/jetbrains-mono": "5.3.0",
    "framer-motion": "14.14.0",
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@lhci/cli": "0.16.1",
    "@playwright/test": "1.65.1",
    "@tailwindcss/postcss": "4.3.5",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "8.0.0",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.13",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "axe-core": "4.14.1",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.6",
    "jsdom": "31.0.1",
    "msw": "3.0.7",
    "openapi-typescript": "7.13.0",
    "postcss": "8.5.33",
    "prettier": "3.10.1",
    "serve": "14.2.8",
    "tailwindcss": "4.3.5",
    "typescript": "5.9.3",
    "vite": "8.3.8",
    "vitest": "5.1.1"
  }
}
